# GEMINI_API_KEY: Required for the AI chat widget and AI cost estimator.
GEMINI_API_KEY=""

# APP_URL: Public URL this app is deployed at (used for CORS origin restriction
# and self-referential links). Set this to your real production URL.
APP_URL="https://orbit-i.tech"

# --- MySQL database connection ---
# On first boot with an empty database, the server creates all required
# tables automatically and seeds them with starter content.
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# --- Security (required — the app will not allow admin login without these) ---

# ADMIN_PASSWORD: SuperAdmin login password. There is no hardcoded fallback —
# if this isn't set, admin login is disabled entirely rather than falling
# back to something guessable. Pick your own, or use this randomly generated
# starting point:
ADMIN_PASSWORD="rC1z348eZhDPeav2xOF7ag"

# JWT_SECRET: Signs admin/client session tokens. If unset, a random one is
# generated at each server boot, which means every cold start silently logs
# everyone out. Set a real value for stable sessions:
JWT_SECRET="53cf8e23b4b9cd327b52dc7841a12b80b7ba89e2de4b23bfcb1932249150faae7526ca3b7e1b9afd7865a5db42e94230"

# VITE_ADMIN_ACCESS_KEY: The secret value that unlocks the SuperAdmin login
# screen via https://yoursite.com/?access=<this value>. Without this set,
# the admin panel is unreachable by URL — there is no default/fallback key.
# This is a Vite build-time variable (VITE_ prefix required) — it must be
# set BEFORE `vite build` runs, e.g. as a Vercel Environment Variable.
# Remember: this ends up in the shipped JS bundle like any frontend code,
# so it only keeps casual visitors out — the real security boundary is the
# ADMIN_PASSWORD + JWT check on the backend, which applies regardless of
# how someone reaches the login screen.
VITE_ADMIN_ACCESS_KEY="SARN-Rumfumw8GaksZ1O_1WVC2Yd5U3U"

